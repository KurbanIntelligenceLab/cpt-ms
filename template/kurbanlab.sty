% Syntax colors follow one rule: STRUCTURE gets brand violet, DATA gets the
% accent tier. Keywords violet; strings teal; numeric literals amber; comments
% italic slate; `self'/`cls' quiet italic. Strings must NOT share the hyperlink
% color -- a string that looks clickable is a design bug.
\lstdefinestyle{kil}{
  basicstyle=\ttfamily\footnotesize\color{kilink},
  keywordstyle=\color{kilviolet}\bfseries,
  keywordstyle=[2]\itshape\color{kilslate},     % self, cls
  commentstyle=\color{kilslate}\itshape,
  stringstyle=\color{kilteal},
  numberstyle=\ttfamily\scriptsize\color{kilslate},% gutter numbers: quiet but LEGIBLE
                                                   % (tiny+lilac fails on white)
  backgroundcolor=\color{kilmist},
  frame=leftline,framerule=2.2pt,rulecolor=\color{killilac},
  framesep=8pt,xleftmargin=10pt,numbers=left,numbersep=9pt,
  showstringspaces=false,upquote=true,
  breaklines=true,breakatwhitespace=true,
  postbreak=\mbox{\textcolor{killilac}{$\hookrightarrow$}\,},% visible wrap marker
  columns=fullflexible,keepspaces=true,
  aboveskip=9pt,belowskip=9pt,belowcaptionskip=4pt,tabsize=4,
  escapeinside={(*@}{@*)},% (*@\LaTeX{} inside code@*) for callouts
  % numeric literals in amber, via listings' identifier hook:
  literate=%
    {0}{{{\color{kilamber}0}}}1 {1}{{{\color{kilamber}1}}}1
    {2}{{{\color{kilamber}2}}}1 {3}{{{\color{kilamber}3}}}1
    {4}{{{\color{kilamber}4}}}1 {5}{{{\color{kilamber}5}}}1
    {6}{{{\color{kilamber}6}}}1 {7}{{{\color{kilamber}7}}}1
    {8}{{{\color{kilamber}8}}}1 {9}{{{\color{kilamber}9}}}1
    % pasted unicode inside code -- listings chokes on these without a map:
    {µ}{{\ensuremath{\mu}}}1 {α}{{\ensuremath{\alpha}}}1 {β}{{\ensuremath{\beta}}}1
    {λ}{{\ensuremath{\lambda}}}1 {σ}{{\ensuremath{\sigma}}}1 {π}{{\ensuremath{\pi}}}1
    {Δ}{{\ensuremath{\Delta}}}1 {≤}{{\ensuremath{\leq}}}1 {≥}{{\ensuremath{\geq}}}1
    {≠}{{\ensuremath{\neq}}}1 {±}{{\ensuremath{\pm}}}1 {×}{{\ensuremath{\times}}}1
    {→}{{\ensuremath{\rightarrow}}}1 {°}{{\ensuremath{^\circ}}}1
}
% Python beyond listings' 2.x-era defaults:
\lstdefinelanguage[kil]{Python}[]{Python}{
  morekeywords={as,async,await,match,case,None,True,False,nonlocal,yield,with},
  morekeywords=[2]{self,cls},
  morestring=[b]{f'},morestring=[b]{f"},% f-strings colored as strings
}
\lstset{style=kil,language=[kil]Python}% Python is the lab default; override per listing

