%% Bibliography that survives a missing .bib. Two ways to arrive here without
%% references.bib: (a) the arXiv tarball, which ships main.bbl only -- correct
%% for arXiv, but Overleaf/latexmk then run BibTeX and die with "I couldn't open
%% database file"; (b) a partial download of the sources. In both cases the .bbl
%% has everything needed. So: if the .bib is missing, DON'T write \bibdata to the
%% .aux (that line is what makes latexmk invoke BibTeX) and input the shipped
%% .bbl directly. Citations resolve; nothing crashes; the log says why.
% Missing-.bib diagnosis. The standard \bibliography works FINE without the
% .bib (only BibTeX reads it; pdflatex reads the .bbl) -- the build tooling is
% what breaks. So behavior is left untouched and the .aux stays honest; the
% shipped .latexmkrc ($bibtex_use = 1.5) then makes latexmk skip BibTeX when
% the .bib is absent and trust the .bbl. This hook's only job is a log message
% that names the situation and both fixes, instead of BibTeX's cryptic
% "I couldn't open database file".
\AtBeginDocument{%
  \let\KIL@stdbibliography\bibliography
  \renewcommand{\bibliography}[1]{%
    \IfFileExists{#1.bib}{}{%
      \IfFileExists{\jobname.bbl}
        {\PackageWarningNoLine{kurbanlab}{#1.bib not found; the shipped
           \jobname.bbl provides the references.\MessageBreak Fine for
           compiling. To EDIT references, put #1.bib next to
           \jobname.tex.\MessageBreak (If plain latexmk still runs BibTeX,
           use the template's .latexmkrc)}}
        {\PackageWarningNoLine{kurbanlab}{#1.bib not found and no \jobname.bbl:
           citations will print as [?].\MessageBreak Place #1.bib next to
           \jobname.tex, or ship the .bbl}}}%
    \KIL@stdbibliography{#1}}}

