%% Draft-friendly graphics: \kilgraphics[<width>]{<path>} behaves exactly like
%% \includegraphics[width=<width>]{<path>} when the file exists. When it does not
%% -- a co-author hasn't pushed it yet, or the figures/ folder didn't travel with
%% main.tex -- it typesets a labeled placeholder at the same width instead of
%% killing the build with "File not found: using draft setting". A paper draft
%% with one missing figure should still compile.
\newcommand{\kilgraphics}[2][\linewidth]{%
  \IfFileExists{#2}
    {\includegraphics[width=#1]{#2}}
    {\PackageWarning{kurbanlab}{Figure file '#2' not found; placeholder used}%
     \begin{tcolorbox}[colback=kilmist,colframe=killine,boxrule=0.6pt,
        sharp corners,width=#1,height=0.52#1,valign=center,halign=center]
       \kilmark[16pt]\par\vspace{5pt}
       {\kilsemi\scriptsize\color{kilslate}MISSING FIGURE}\par\vspace{2pt}
       {\ttfamily\scriptsize\color{kilslate}\detokenize{#2}}%
     \end{tcolorbox}}}

%% Footnotes: a short killine rule instead of the default black bar, and a
%% little more separation -- footnotes should whisper.
% \footnoterule must occupy ZERO net height -- its room is pre-reserved by
% \skip\footins, and any real height it adds overfills the page box with the
% cryptic "Overfull \vbox while \output is active". Hence the kernel's negative-
% kern idiom: draw the rule inside space that is already there.
\renewcommand{\footnoterule}{%
  \kern-3.4pt{\color{killine}\hrule width 0.24\linewidth height 0.4pt}\kern3pt}
\setlength{\footnotesep}{8pt}
\addtolength{\skip\footins}{3pt}% a little extra air above the rule, paid for honestly
% Preprint pages carry floats of every size; stretching interline glue to force a
% flush bottom (article's two-side default) produces exactly the "Overfull \vbox
% while \output is active" class of warning. Ragged bottoms are the honest choice.
\raggedbottom

