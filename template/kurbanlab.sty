\newcommand{\KIL@back}[1]{%
  \par\addvspace{12pt}%
  {\noindent\kilsemi\footnotesize\color{kilink}\textls[170]{\MakeUppercase{#1}}\par}%
  \vspace{3pt}\small\noindent\ignorespaces}
\newenvironment{acknowledgments}{\KIL@back{Acknowledgments}}{\par\addvspace{4pt}}
\newenvironment{contributions} {\KIL@back{Author contributions}}{\par\addvspace{4pt}}
\newenvironment{funding}       {\KIL@back{Funding}}{\par\addvspace{4pt}}
\newenvironment{availability}  {\KIL@back{Data and code availability}}{\par\addvspace{4pt}}
\newenvironment{conflicts}     {\KIL@back{Competing interests}}{\par\addvspace{4pt}}
% Blind mode: these must not leak identity, so drop them wholesale.
% `availability' and `conflicts' are KEPT -- most venues require them even under
% double-blind -- which means their prose is yours to anonymize. So is every
% self-citation, repo URL and dataset name elsewhere in the paper. Say so, loudly,
% rather than let anyone assume `blind' did more than it can.
\ifKIL@blind
  \RequirePackage{comment}
  \excludecomment{acknowledgments}
  \excludecomment{funding}
  \excludecomment{contributions}
  \AtEndDocument{%
    \PackageWarningNoLine{kurbanlab}{%
      BLIND MODE.\MessageBreak
      Removed: authors, affiliations, logo, acknowledgments, funding,\MessageBreak
      contributions, running head, and PDF metadata.\MessageBreak
      NOT removed (only you can judge these):\MessageBreak
      \space\space* repo/data URLs, incl. in the availability statement\MessageBreak
      \space\space* self-citations phrased as "our previous work"\MessageBreak
      \space\space* named internal datasets, clusters or grant numbers\MessageBreak
      Read the PDF once as a reviewer before you upload it}}
\fi

