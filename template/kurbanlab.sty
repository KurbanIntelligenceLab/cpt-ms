% HH:MM at compile time, for the review-mode footer -- so a desk covered in
% printouts still tells you which one is current.
\NewExpandableDocumentCommand \KILtimestamp {}
  {
    \int_compare:nNnT { \int_div_truncate:nn { \time } { 60 } } < { 10 } { 0 }
    \int_eval:n { \int_div_truncate:nn { \time } { 60 } }
