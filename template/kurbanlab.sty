%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% kurbanlab.sty  --  preprint / arXiv style for the Kurban Intelligence Lab
%% Hamad Bin Khalifa University, Doha, Qatar
%%
%% v1.0 (2026-07-13).  pdfLaTeX only, on purpose: arXiv's AutoTeX does not run
%% XeLaTeX/LuaLaTeX and never runs Biber.  So: Type1-capable fonts, natbib +
%% BibTeX, no shell-escape.  Compiles on a stock TeX Live / Overleaf install and
%% degrades gracefully if a font package is missing on the build host.
%%
%%   \usepackage[<options>]{kurbanlab}
%%
%% OPTIONS
%%   font=libertinus|times|charter   body + math family      (default libertinus)
%%   citestyle=numeric|authoryear    natbib mode             (default numeric)
%%   paper=letterpaper|a4paper                               (default letterpaper)
%%   status={Preprint}               badge beside the logo; status={} hides it
%%   blind                           strip authors/affils/logo/acks (double-blind)
%%   review                          line numbers, looser leading, \todo visible
%%   nologo                          suppress the lockup
%%   nomath                          leave math fonts untouched
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kurbanlab}[2026/07/17 v2.1 Kurban Intelligence Lab preprint style]

% hyperref is loaded for us by orcidlink, long before section 18 -- so anything
% that must be a LOAD-TIME option goes here. `unicode' makes PDF metadata strings
% UTF-8-aware: without it, an author named \c{S}eyma \"Ozt\"urk becomes mojibake
% in the pdfauthor field, which is exactly what Google Scholar indexes.
\PassOptionsToPackage{unicode}{hyperref}

\RequirePackage{kvoptions}
\RequirePackage{etoolbox}
\SetupKeyvalOptions{family=KIL,prefix=KIL@}
\DeclareStringOption[libertinus]{font}
\DeclareStringOption[numeric]{citestyle}
\DeclareStringOption[letterpaper]{paper}
\DeclareStringOption[Preprint]{status}
\DeclareBoolOption{blind}
\DeclareBoolOption{review}
\DeclareBoolOption{nologo}
\DeclareBoolOption{nomath}
\ProcessKeyvalOptions*

