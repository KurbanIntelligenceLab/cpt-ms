%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 6  THE MARK  --  \kilmark[<height>]  (native TikZ, zero file dependencies)
%%     \kilmark*[<height>] draws it in the current colour (mono / dark grounds)
%% Geometry: an 86x100 unit box. bar x=13; node (21,50) r=10; arms (21,50) to
%% (76,92) and (76,8); one linear gradient shared by both arms, axis ~ -25 deg.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\KIL@armgrad}[5]{% x1 y1 x2 y2 linewidth
  \foreach \KILi in {0,...,25}{%
    \pgfmathsetmacro{\KILta}{\KILi/26}\pgfmathsetmacro{\KILtb}{(\KILi+1)/26}%
    \pgfmathsetmacro{\KILxa}{#1+(#3-#1)*\KILta}\pgfmathsetmacro{\KILya}{#2+(#4-#2)*\KILta}%
    \pgfmathsetmacro{\KILxb}{#1+(#3-#1)*\KILtb}\pgfmathsetmacro{\KILyb}{#2+(#4-#2)*\KILtb}%
    \pgfmathsetmacro{\KILmx}{max(0,min(100,100*(0.01136*(\KILxa+\KILxb)/2
      -0.005357*(\KILya+\KILyb)/2+0.1793)))}%
    \draw[color=killilac!\KILmx!kilviolet,line width=#5,line cap=round]
      (\KILxa,\KILya)--(\KILxb,\KILyb);%
  }%
}
\newif\ifKIL@monomark
\newcommand{\kilmark}{\@ifstar{\KIL@monomarktrue\KIL@drawmark}{\KIL@monomarkfalse\KIL@drawmark}}
\newcommand{\KIL@drawmark}[1][11pt]{%
  \begingroup
  \pgfmathsetlengthmacro{\KIL@u}{#1/100}%
  \pgfmathsetlengthmacro{\KIL@bw}{17*#1/100}%
  \pgfmathsetlengthmacro{\KIL@aw}{14*#1/100}%
  \begin{tikzpicture}[x=\KIL@u,y=\KIL@u,baseline=0pt]
    \ifKIL@monomark
      \draw[line width=\KIL@bw,line cap=round] (13,9)--(13,91);
      \draw[line width=\KIL@aw,line cap=round] (21,50)--(76,92);
      \draw[line width=\KIL@aw,line cap=round] (21,50)--(76,8);
      \fill (21,50) circle[radius=10];
    \else
      \draw[kilink,line width=\KIL@bw,line cap=round] (13,9)--(13,91);
      \KIL@armgrad{21}{50}{76}{92}{\KIL@aw}%
      \KIL@armgrad{21}{50}{76}{8}{\KIL@aw}%
      \shade[ball color=killilac] (21,50) circle[radius=10];
    \fi
  \end{tikzpicture}%
  \endgroup}

%% Lockup: prefers the high-resolution PNG artwork (tightly cropped, K bottom and
%% INTELLIGENCE LAB bottom flush with the canvas edge, KURBAN above), then the
%% vector PDF, then a native redraw. NOTE: the assets live under figures/logo/ --
%% an earlier logo/ path failed \IfFileExists silently, so every build fell back
%% to the native redraw and the real artwork never appeared on the page.
\newcommand{\killockup}[1][34pt]{%
  \IfFileExists{figures/logo/kil-lockup.png}
    {\includegraphics[height=#1]{figures/logo/kil-lockup.png}}
    {\IfFileExists{figures/logo/kil-lockup.pdf}
      {\includegraphics[height=#1]{figures/logo/kil-lockup.pdf}}
      {\KIL@nativelockup{#1}}}}
\newcommand{\KIL@nativelockup}[1]{%
  \begingroup
  \kilmark[#1]\hspace{0.24\dimexpr#1\relax}%
  \raisebox{0.06\dimexpr#1\relax}{\begin{tabular}{@{}l@{}}
    {\kilxb\fontsize{\dimexpr0.72\dimexpr#1\relax}{0pt}\selectfont\color{kilink}KURBAN}\\[0.11\dimexpr#1\relax]
    {\kilmed\fontsize{\dimexpr0.20\dimexpr#1\relax}{0pt}\selectfont\color{kilslate}%
     \textls[300]{INTELLIGENCE LAB}}
  \end{tabular}}%
  \endgroup}

%% Brand rule: the mark's gradient, stretched flat.
\newcommand{\kilrule}[1][1.6pt]{%
  \par\noindent
  \begin{tikzpicture}
    \shade[left color=kilink,middle color=kilviolet,right color=killilac]
      (0,0) rectangle (\linewidth,#1);
  \end{tikzpicture}\par}
\newcommand{\kilhairline}{\par\noindent{\color{killine}\rule{\linewidth}{0.4pt}}\par}

%% Envelope glyph for the corresponding author (drawn: no extra font package).
\protected\def\KIL@envelope{%
  \tikz[baseline=-0.05ex,x=0.085em,y=0.085em,line width=0.35pt,line join=round]{%
    \draw (0,0) rectangle (7,5);\draw (0,5)--(3.5,1.9)--(7,5);}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 7  AUTHOR / AFFILIATION ENGINE
%% Affiliations are addressed by KEY, never by number. Numbers are assigned in
%% order of first use, so adding or dropping a collaborator renumbers the paper
%% automatically -- and unused institutions never appear. Keep the registry in
%% affiliations.tex and share it across every paper the lab writes.
%%
%%   \DeclareAffiliation{tamu}{Dept. of ..., Texas A\&M University, ...}
%%   \Author{Jane Doe}{hbku}
%%   \Author[equal, orcid=0000-0002-1825-0097]{John Roe}{hbku,tamu}
%%   \Author[corresponding=hasan.kurban@hbku.edu.qa]{Hasan Kurban}{hbku}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newif\ifKIL@hasequal
\newif\ifKIL@hascorr
% \Correspondence and \KILprintcorrmails live in the expl3 block below: several
% authors can be corresponding, so the emails are a list, not a macro.
\newcommand{\KIL@authorsep}{%
  \hspace{0.8em}\raisebox{0.3ex}{\color{killilac}\rule{2.4pt}{2.4pt}}\hspace{0.8em}}

\ExplSyntaxOn
\prop_new:N \g_kil_afftext_prop   % key -> text
\prop_new:N \g_kil_affnum_prop    % key -> number
\seq_new:N  \g_kil_afforder_seq   % keys in order of first use
\seq_new:N  \g_kil_author_seq     % typeset entries
\seq_new:N  \g_kil_authname_seq   % plain names, for PDF metadata
\int_new:N  \g_kil_affcount_int
\bool_new:N \l_kil_equal_bool
\bool_new:N \l_kil_corr_bool
\tl_new:N   \l_kil_orcid_tl
\tl_new:N   \l_kil_note_tl
\tl_new:N   \l_kil_sup_tl
\tl_new:N   \l_kil_entry_tl
\tl_new:N   \l_kil_brace_tl
\clist_new:N \g_kil_corrmail_clist
\tl_new:N   \g_kil_authplain_tl   % names as a flat token list, for \pdfstringdef

% Any number of authors may carry corresponding=...; collect every email.
\NewDocumentCommand \Correspondence { m }
  { \clist_gput_right:Nn \g_kil_corrmail_clist {#1} \global\KIL@hascorrtrue }
\NewDocumentCommand \KILprintcorrmails {}
  {
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \g_kil_corrmail_clist
      {
        \int_incr:N \l_tmpa_int
        \int_compare:nNnT { \l_tmpa_int } > { 1 } { ,~ }
        \href {mailto:##1} { \nolinkurl {##1} }
      }
  }

\keys_define:nn { kil / author }
  {
    equal    .bool_set:N = \l_kil_equal_bool,
    equal    .default:n  = { true },
    orcid    .tl_set:N   = \l_kil_orcid_tl,
    footnote .tl_set:N   = \l_kil_note_tl,
    corresponding .code:n =
      { \bool_set_true:N \l_kil_corr_bool \tl_if_blank:nF {#1} { \Correspondence {#1} } },
    corresponding .default:n = { },
  }

\msg_new:nnn { kurbanlab } { unknown-affil }
  { Affiliation~key~'#1'~was~never~declared~with~\string\DeclareAffiliation. }

\NewDocumentCommand \DeclareAffiliation { m m }
  { \prop_gput:Nnn \g_kil_afftext_prop {#1} {#2} }

\cs_new_protected:Npn \__kil_touch:n #1
  {
    \prop_if_in:NnF \g_kil_affnum_prop {#1}
      {
        \prop_if_in:NnF \g_kil_afftext_prop {#1}
          { \msg_warning:nnn { kurbanlab } { unknown-affil } {#1} }
        \int_gincr:N \g_kil_affcount_int
        \tl_set:Nx \l_tmpa_tl { \int_use:N \g_kil_affcount_int }
        \prop_gput:NnV \g_kil_affnum_prop {#1} \l_tmpa_tl
        \seq_gput_right:Nn \g_kil_afforder_seq {#1}
      }
  }

\NewDocumentCommand \Author { O{} m m }
  {
    \group_begin:
      \bool_set_false:N \l_kil_equal_bool
      \bool_set_false:N \l_kil_corr_bool
      \tl_clear:N \l_kil_orcid_tl
      \tl_clear:N \l_kil_note_tl
      \keys_set:nn { kil / author } {#1}
      % superscript markers, built with NO expansion (safe for \tikz, $, etc.)
      \tl_clear:N \l_kil_sup_tl
      \int_zero:N \l_tmpa_int
      \clist_map_inline:nn {#3}
        {
          \tl_if_blank:nF {##1}
            {
              \__kil_touch:n {##1}
              \int_incr:N \l_tmpa_int
              \int_compare:nNnT { \l_tmpa_int } > { 1 }
                { \tl_put_right:Nn \l_kil_sup_tl { , } }
              \prop_get:NnN \g_kil_affnum_prop {##1} \l_tmpb_tl
              \tl_put_right:NV \l_kil_sup_tl \l_tmpb_tl
            }
        }
      \bool_if:NT \l_kil_equal_bool
        {
          \tl_if_empty:NF \l_kil_sup_tl { \tl_put_right:Nn \l_kil_sup_tl { , } }
          \tl_put_right:Nn \l_kil_sup_tl { $\ast$ }
          \global \KIL@hasequaltrue
        }
      \bool_if:NT \l_kil_corr_bool
        {
          \tl_if_empty:NF \l_kil_sup_tl { \tl_put_right:Nn \l_kil_sup_tl { , } }
          \tl_put_right:Nn \l_kil_sup_tl { \KIL@envelope }
        }
      \tl_if_blank:VF \l_kil_note_tl
        {
          \tl_if_empty:NF \l_kil_sup_tl { \tl_put_right:Nn \l_kil_sup_tl { , } }
          \tl_put_right:NV \l_kil_sup_tl \l_kil_note_tl
        }
      % the typeset entry
      \tl_clear:N \l_kil_entry_tl
      \tl_put_right:Nn \l_kil_entry_tl {#2}
      \tl_if_blank:VF \l_kil_orcid_tl
        {
          \tl_put_right:Nn \l_kil_entry_tl { \, \orcidlink }
          \tl_set:Nx \l_kil_brace_tl { { \l_kil_orcid_tl } }
          \tl_put_right:NV \l_kil_entry_tl \l_kil_brace_tl
        }
      \tl_if_empty:NF \l_kil_sup_tl
        {
          \tl_put_right:Nn \l_kil_entry_tl { \textsuperscript }
          \tl_set:Nx \l_kil_brace_tl { { \exp_not:V \l_kil_sup_tl } }
          \tl_put_right:NV \l_kil_entry_tl \l_kil_brace_tl
        }
      % An \mbox around the whole entry so "Jos\'e Mar\'ia"'s first and last
      % names -- and the superscripts -- can never be separated by a line break.
      \tl_set:Nx \l_kil_brace_tl { { \exp_not:V \l_kil_entry_tl } }
      \tl_clear:N \l_kil_entry_tl
      \tl_put_right:Nn \l_kil_entry_tl { \mbox }
      \tl_put_right:NV \l_kil_entry_tl \l_kil_brace_tl
      \seq_gput_right:NV \g_kil_author_seq \l_kil_entry_tl
      \seq_gput_right:Nn \g_kil_authname_seq {#2}
      % Flat copy for PDF metadata. \pdfstringdef handles a plain macro body the
      % same way it handles \@title -- inputenc's protected actives survive the
      % x-expansion untouched, so unicode names reach the Author field intact.
      \tl_gset:Nx \g_kil_authplain_tl
        { \seq_use:Nnnn \g_kil_authname_seq { ,~ } { ,~ } { ,~ } }
    \group_end:
  }

% LaTeX2e-facing exports: safe to use inside \maketitle's normal-catcode body.
\NewDocumentCommand \KILprintauthors {}
  { \seq_use:Nnnn \g_kil_author_seq { \KIL@authorsep } { \KIL@authorsep } { \KIL@authorsep } }
