\newsavebox{\KIL@badgebox}% holds the badge so the venue can be centred under it
\renewcommand{\maketitle}{%
  \par\begingroup
  % No line numbers down the author/affiliation list -- nobody cites those, and
  % they make the title page look like a draft. \endgroup restores the setting.
  \ifbool{KIL@review}{\nolinenumbers}{}%
  \ifboolexpr{ bool {KIL@nologo} or bool {KIL@blind} }{}{%
    \noindent
    \begin{minipage}[b]{0.60\linewidth}\killockup[34pt]\end{minipage}\hfill
    \begin{minipage}[b]{0.38\linewidth}\raggedleft
      \ifdefempty{\KIL@status}{}{%
        % Capture the badge so the venue can be centred to ITS width; a plain
        % raggedleft venue only shares the badge's right edge and sits off-centre.
        \sbox\KIL@badgebox{%
          \tcbox[on line,boxrule=0.6pt,colframe=killine,colback=kilmist,
                 left=7pt,right=7pt,top=2.5pt,bottom=2.5pt,sharp corners,boxsep=0pt]
            {\KIL@labeltext{kilslate}{\KIL@status}}}%
        \usebox\KIL@badgebox}%
      % The \\ must only fire if a badge was actually typeset above it; with
      % status={} there is no line to end, and LaTeX says exactly that.
      \ifdefempty{\KIL@venue}{}{%
        \ifdefempty{\KIL@status}
          {{\footnotesize\color{kilslate}\KIL@venue}}%
          {\\[4pt]\makebox[\wd\KIL@badgebox][c]{\footnotesize\color{kilslate}\KIL@venue}}}%
    \end{minipage}
    \par\vspace{10pt}}
  \kilrule[1.6pt]
  \vspace{16pt}
  {\raggedright\kilsemi\fontseries{b}\selectfont\fontsize{19.5}{23.5}\selectfont
   \color{kilink}\textls[-14]{\@title}\par}
  \ifdefempty{\KIL@subtitle}{}{%
    \vspace{6pt}%
    {\raggedright\sffamily\fontseries{l}\selectfont\fontsize{12.5}{15.5}\selectfont
     \color{kilslate}\KIL@subtitle\par}}
  \vspace{16pt}
  {\raggedright\normalsize\color{kilink}%
   \ifbool{KIL@blind}{\itshape Author list withheld for double-blind review}%
                     {\KILprintauthors}\par}
  \vspace{8pt}
  {\raggedright\footnotesize\color{kilslate}\setlength{\parskip}{1.5pt}%
   \ifbool{KIL@blind}{\itshape Affiliations withheld for double-blind review\par}%
                     {\KILprintaffils}}
  % NB: this whole block is written with etoolbox's \notbool/\ifbool rather than
  % \ifKIL@blind ... \fi. In blind mode TeX SKIPS this region, and TeX's skipper
  % counts bare \if tokens even inside braces -- a `test {\ifKIL@hasequal}' here
  % would swallow the matching \fi and take the rest of the document with it.
  % Passing branches as arguments keeps the primitives out of the skipped text.
  \notbool{KIL@blind}{%
    \ifboolexpr{ bool {KIL@hasequal} or bool {KIL@hascorr} }{%
      \vspace{6pt}%
      {\raggedright\footnotesize\color{kilslate}%
       \ifbool{KIL@hasequal}{$\ast$\,Equal contribution.\hspace{0.9em}}{}%
       \ifbool{KIL@hascorr}{\KIL@envelope\,Correspondence:
         \KILprintcorrmails}{}\par}}{}%
  }{}%
  \vspace{3pt}
  \endgroup
  \thispagestyle{kiltitle}%
}

