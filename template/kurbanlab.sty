% NOTE: orcidlink pulls hyperref in on its own, so the options are handed over
% early (section 1) with \PassOptionsToPackage -- loading it with options here
% would raise "Option clash for package hyperref". Colours are set below anyway.
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,breaklinks=true,
  linkcolor=killink,citecolor=killink,urlcolor=killink,filecolor=killink,
  pdfstartview=FitH,pdfpagemode=UseOutlines}
% A \\ in the title is a line break on the page; in a PDF metadata string it is
% nothing at all. Turn it into a space rather than let hyperref complain.
\pdfstringdefDisableCommands{\def\\{ }\def\kilmark{}\def\kilrule{}}
\RequirePackage[nameinlink,capitalise]{cleveref}
\crefname{equation}{Eq.}{Eqs.}
\crefname{figure}{Fig.}{Figs.}
\crefname{table}{Table}{Tables}
\crefname{section}{Sec.}{Secs.}
\crefname{algorithm}{Alg.}{Algs.}
% Theorem-like environments. cleveref auto-detects amsthm environments, but the
% names are declared explicitly so the plurals and spelling are ours, not a
% guess -- and so \Cref at a sentence start capitalises correctly. Full words
% (not "Thm."), which is the house style for named results; abbreviate here if a
% target venue prefers it.
\crefname{theorem}{Theorem}{Theorems}
\crefname{lemma}{Lemma}{Lemmas}
\crefname{proposition}{Proposition}{Propositions}
\crefname{corollary}{Corollary}{Corollaries}
\crefname{conjecture}{Conjecture}{Conjectures}
\crefname{claim}{Claim}{Claims}
\crefname{definition}{Definition}{Definitions}
\crefname{assumption}{Assumption}{Assumptions}
\crefname{condition}{Condition}{Conditions}
\crefname{property}{Property}{Properties}
\crefname{problem}{Problem}{Problems}
\crefname{question}{Question}{Questions}
\crefname{example}{Example}{Examples}
\crefname{fact}{Fact}{Facts}
\crefname{observation}{Observation}{Observations}
\crefname{remark}{Remark}{Remarks}
\crefname{notation}{Notation}{Notations}

% PDF metadata, filled from the paper's own macros. arXiv and Google Scholar
% both read this, so it is worth getting right.
%
% The title/author/keywords are set with \pdfstringdef rather than \hypersetup:
% hypersetup pre-expands macro-valued keys, which strands inputenc's protected
% \UTFviii actives and turns "\c{S}eyma \"Ozt\"urk" into mojibake in the PDF's
% Author field. \pdfstringdef is hyperref's own encoder, called the way
% `pdfusetitle' calls it -- unicode names survive intact.
\AtBeginDocument{%
  \pdfstringdef\@pdftitle{\@title}%
  \ifKIL@blind
    \pdfstringdef\@pdfauthor{Anonymous}%
  \else
    \pdfstringdef\@pdfauthor{\KILplainauthornames}%
  \fi
  \pdfstringdef\@pdfkeywords{\KIL@keywords}%
  \hypersetup{
    pdfsubject={Preprint. Kurban Intelligence Lab, Hamad Bin Khalifa University.},
    pdfcreator={pdfLaTeX with kurbanlab.sty}}}

