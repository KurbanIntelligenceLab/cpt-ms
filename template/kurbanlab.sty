%% -- Theorem ecosystem --------------------------------------------------------
%% Two voices, one counter. FORMAL RESULTS (theorem, lemma, ...) set their body
%% in italic -- the mathematician's convention, and it visually separates a
%% claim-to-be-proved from the prose around it. STRUCTURAL statements
%% (definition, assumption, remark, example, ...) stay upright: they are read,
%% not proved, and italicising a half-page definition punishes the reader. The
%% head in both is Montserrat SemiBold in the ink navy -- the same label voice as
%% every other structural cue in the paper. All share the `theorem' counter, so a
%% paper reads "Theorem 1 ... Lemma 2 ... Definition 3" in one honest sequence and
%% \cref resolves each by its own name (wired up next to the other \crefname's in
%% section 18). Change the counter tie below to `section' for per-section
%% numbering if a long paper needs it.
%%
%% Every environment also has a STARRED, UNNUMBERED twin (theorem*, lemma*, ...).
%% Use it to RESTATE a named result -- e.g. repeating Theorem 3 in the appendix
%% before its full proof -- without minting a second number. Give the restatement
%% the original's number by hand if you like: \begin{theorem*}[Theorem~\ref{thm:x}]
%% -- Head design ---------------------------------------------------------------
%% The head is built to speak the SAME visual language as every other numbered
%% object in the paper. Sections colour their number violet; figures, tables,
%% algorithms and listings introduce their title with a lilac vertical bar
%% ("Figure 1 | ..."). Theorems used to do neither -- a flat navy head, the one
%% structural cue that sat outside the system. Now they match:
%%   NAME   Montserrat SemiBold, ink navy   (the object: Theorem, Lemma, ...)
%%   NUMBER violet                          (rhymes with every section number)
%%   | BAR  lilac, only when a title exists  (the caption separator, reused)
%%   TITLE  Montserrat Medium, slate         (recedes behind the name)
%% Result: a head with three levels of hierarchy instead of one flat line, and a
%% theorem that looks like it belongs to the same paper as its figures.
%%
%% \KIL@thmbar is the caption bar (section 10's kilbar), rebuilt here as a token
%% so it can live inside amsthm's note slot. The head template is written inline in
%% each style with amsthm's bare #1/#2/#3 (name / number / note); amsthm's 9th
%% argument is a head SPEC, not a macro body, so a single # is correct here and a
%% wrapper macro (which would need ##) is not.
\newcommand{\KIL@thmbar}{\,\textcolor{killilac}{\rule[-0.15ex]{0.9pt}{1.55ex}}\,}
\newcommand{\KIL@thmbarq}{\,\textcolor{killine}{\rule[-0.15ex]{0.9pt}{1.55ex}}\,}

\newtheoremstyle{kil}   % italic body: formal, to-be-proved results
  {11pt}{9pt}{\itshape}{0pt}{\kilsemi\color{kilink}}{.}{0.5em}
  {\thmname{#1}\,\textcolor{kilviolet}{\thmnumber{#2}}%
   \thmnote{\KIL@thmbar{\normalfont\kilmed\color{kilslate}#3}}}
\newtheoremstyle{kilup} % upright body: definitional / structural statements
  {11pt}{9pt}{\normalfont}{0pt}{\kilsemi\color{kilink}}{.}{0.5em}
  {\thmname{#1}\,\textcolor{kilviolet}{\thmnumber{#2}}%
   \thmnote{\KIL@thmbar{\normalfont\kilmed\color{kilslate}#3}}}
% Remark-tier: upright body, quieter slate head -- these are asides, and the head
% should not compete with a Theorem for the eye. Everything slate; a hairline bar.
\newtheoremstyle{kilrem}
  {11pt}{9pt}{\normalfont}{0pt}{\kilsemi\color{kilslate}}{.}{0.5em}
  {\thmname{#1}\,{\color{kilslate}\thmnumber{#2}}%
   \thmnote{\KIL@thmbarq{\normalfont\kilmed\color{kilslate}#3}}}

% One counter, many names. Every environment shares the `theorem' NUMBER (so the
% paper reads Theorem 1 ... Lemma 2 ... Definition 3 in one sequence), but each
% keeps its own IDENTITY for cleveref -- otherwise \cref{as:x} prints "Theorem 2",
% because plain \newtheorem{x}[theorem]{X} shares the counter AND collapses the
% cref type onto it. thmtools' `sibling=theorem' is the clean fix: shared value,
% own type. It honours the \newtheoremstyle heads defined above, so the design is
% unchanged; only the bookkeeping is correct now.
\RequirePackage{thmtools}
\theoremstyle{kil}
\newtheorem{theorem}{Theorem}   % the base counter every sibling shares

\declaretheorem[style=kil,   sibling=theorem, name=Lemma]{lemma}
\declaretheorem[style=kil,   sibling=theorem, name=Proposition]{proposition}
\declaretheorem[style=kil,   sibling=theorem, name=Corollary]{corollary}
\declaretheorem[style=kil,   sibling=theorem, name=Conjecture]{conjecture}
\declaretheorem[style=kil,   sibling=theorem, name=Claim]{claim}

\declaretheorem[style=kilup, sibling=theorem, name=Definition]{definition}
\declaretheorem[style=kilup, sibling=theorem, name=Assumption]{assumption}
\declaretheorem[style=kilup, sibling=theorem, name=Condition]{condition}
\declaretheorem[style=kilup, sibling=theorem, name=Property]{property}
\declaretheorem[style=kilup, sibling=theorem, name=Problem]{problem}
\declaretheorem[style=kilup, sibling=theorem, name=Question]{question}
\declaretheorem[style=kilup, sibling=theorem, name=Example]{example}
\declaretheorem[style=kilup, sibling=theorem, name=Fact]{fact}
\declaretheorem[style=kilup, sibling=theorem, name=Observation]{observation}
\declaretheorem[style=kilup, sibling=theorem, name=Notation]{notation}

\declaretheorem[style=kilrem, sibling=theorem, name=Remark]{remark}

% Starred twins: identical styling, no counter. `\newtheorem*' needs each name
% declared once; they cannot alias a numbered sibling, so restatements are free.
\theoremstyle{kil}
\newtheorem*{theorem*}{Theorem}
\newtheorem*{lemma*}{Lemma}
\newtheorem*{proposition*}{Proposition}
\newtheorem*{corollary*}{Corollary}
\newtheorem*{claim*}{Claim}
\theoremstyle{kilup}
\newtheorem*{definition*}{Definition}
\newtheorem*{assumption*}{Assumption}
\newtheorem*{example*}{Example}
\theoremstyle{kilrem}
\newtheorem*{remark*}{Remark}
\newtheorem*{note}{Note}

% Proof: the QED square is drawn in brand violet, not the default black bar --
% it is the one glyph that closes an argument, and it should belong to the palette.
% \KIL@qed is size-relative so it matches whatever the surrounding text size is.
\renewcommand{\proofname}{\normalfont\kilsemi\color{kilink}Proof}
\renewcommand{\qedsymbol}{{\color{kilviolet}\rule{0.62ex}{1.5ex}}}
% A named proof, "Proof of Theorem 1.", is a courtesy in any paper with more than
% a couple of results. \begin{proof}[Proof of \cref{thm:x}] already does this via
% amsthm's optional argument -- documented here so nobody re-invents it.
%
% Proof sketch: for the argument you give in the body and finish in the appendix.
% The lab voice leans on this ("sketch ... defer the full derivation"), so it earns
% a first-class environment rather than an ad-hoc \paragraph{Proof sketch}. No QED
% square -- a sketch is deliberately not closed.
\newenvironment{proofsketch}[1][\proofsketchname]
  {\par\pushQED{\relax}% swallow any stray \qedhere without drawing a box
   \normalfont\topsep6\p@\@plus6\p@\relax\trivlist
   \item[\hskip\labelsep{\normalfont\kilsemi\color{kilink}#1.}]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}
\newcommand{\proofsketchname}{Proof sketch}

\floatstyle{ruled}\restylefloat{algorithm}
\captionsetup[algorithm]{font={small,color=kilslate},
  labelfont={color=kilink,kilsb},labelsep=kilbar,skip=4pt}
