      "crystal": {
        "level": "line-level pseudo-token stream (not per-character); the grammar mask itself operates per-character over a CIF skeleton (scripts/crystal/cif_grammar.py) but the trained model's vocabulary is the coarser CrystalVocab token set",
        "vocab_size_default": 500,
        "vocab_size_conditional_smoke_variant": 884,
        "vocab_composition": {
          "special": [
            "<BOS>",
            "<COMP>",
            "<END_COMP>",
            "<CELL>",
            "<END_CELL>",
            "<EOS>"
          ],
          "elements": "one token per element in ELEMENTS (94 elements, H through Pu)",
          "counts": "cnt:1 .. cnt:N_CNT (N_CNT=16)",
          "cell_lengths": "len:0 .. len:N_LEN-1, uniform bins over [LEN_LO, LEN_HI]",
          "cell_angles": "ang:0 .. ang:N_ANG-1, uniform bins over [ANG_LO, ANG_HI]"
        },
        "main_text_runs_resolution": {
          "N_LEN": 256,
          "N_ANG": 128,
          "N_CNT": 16,
          "resulting_vocab": 500
        },
        "current_source_default_resolution": {
          "N_LEN": 512,
          "N_ANG": 256,
          "N_CNT": 16,
          "resulting_vocab_at_current_ranges": 884
        },
        "bin_ranges_current": {
          "LEN_LO": 2.0,
          "LEN_HI": 46.0,
          "ANG_LO": 5.0,
          "ANG_HI": 175.0
        },
        "resolution_rationale": "chosen from measured MP-20 median relative discretization error, not convention: 64/32 bins -> 4.4%, 128/64 -> 2.4%, 256/128 -> 1.1%, 512/256 -> 0.6% (all measured under an earlier, narrower bin range). All crystal_A{1,2,3}_seed*.json runs used the 256/128 setting and its earlier range, giving vocab_size=500 as recorded in every one of those artifacts. A later fix widened the bin range to cover the full MP-20 support after a clamping defect was found (bin_index_caveat, below) and re-set resolution to 512/256 together with the new range, giving an 884-token vocabulary with 0.84% overall error; crystal_A4_smoke.json is the one artifact in this repository built with that corrected tokenizer.",
        "serialization_order": "cell_first (default) or comp_first; cell_first is required for the density constraint to be expressible as a per-step linear budget, since density is mass/volume and the volume must close before the mass channel can be evaluated",
        "bin_index_caveat": "len:/ang: token payloads are BIN INDICES, not physical values; a past defect in scripts/train/train_crystal.py read them as floats directly, inflating the decoded cell volume by a factor of hundreds and silently producing a plausible-looking but wrong budget. The budget computation now always maps the index through the bin centre (V.LEN_LO + (j + 0.5) * (V.LEN_HI - V.LEN_LO) / V.N_LEN) before using it."
      },
